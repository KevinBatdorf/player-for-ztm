{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    // WXT maps "@/*" to "../*"; right for tsc, but the shadcn CLI installs a level too high.
    "baseUrl": ".",
    "paths": {
      "@": ["."],
      "@/*": ["./*"],
      "~": ["."],
      "~/*": ["./*"]
    }
  },
  "exclude": ["**/node_modules", ".output", "_prototype"]
}
